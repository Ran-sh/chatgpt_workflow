{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Task Contract",
  "type": "object",
  "required": ["id", "mode", "objective", "source_commit", "validation"],
  "properties": {
    "id": {"type": "string"},
    "mode": {"enum": ["IMPLEMENT", "TEST_ONLY", "REVIEW_ONLY"]},
    "source_commit": {"type": "string"},
    "objective": {"type": "string"},
    "allowed_changes": {"type": "array", "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "string"}},
    "result_contract": {"type": "string"}
  }
}
